
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FullAccessToDevelopmentTaggedResources",
      "Effect": "Allow",
      "Action": "ec2:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Env": "development"
        }
      }
    },
    {
      "Sid": "AllowDescribeForConsoleVisibility",
      "Effect": "Allow",
      "Action": "ec2:Describe*",
      "Resource": "*"
    },
    {
      "Sid": "DenyTagChangesToPreventPrivilegeEscalation",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteTags",
        "ec2:CreateTags"
      ],
      "Resource": "*"
    }
  ]
}
